{
  "name": "mergeproof",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first, exact-revision PR verification and automatic merge control plane.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "config:check": "node --env-file-if-exists=.env --import tsx src/config-check.ts",
    "demo": "tsx src/demo.ts",
    "e2b:smoke": "node --env-file-if-exists=.env --import tsx src/e2b-smoke.ts",
    "e2b:harness:smoke": "node --env-file-if-exists=.env --import tsx src/e2b-harness-smoke.ts",
    "github:activation-check": "node --env-file-if-exists=.env --import tsx src/github-activation-check.ts",
    "openai:smoke": "node --env-file-if-exists=.env --import tsx src/openai-smoke.ts",
    "scale:smoke": "tsx src/scale-smoke.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "preflight": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node --env-file-if-exists=.env --import tsx src/serve.ts"
  },
  "dependencies": {
    "@openai/agents": "0.13.3",
    "e2b": "2.33.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
