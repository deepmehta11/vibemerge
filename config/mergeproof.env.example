# Copy this shape into your platform's secret/configuration manager. Do not
# commit a filled version of this file. Values marked SET_IN_SECRET_MANAGER
# must be injected by the deployment platform rather than stored in policy or
# harness files.
PORT=3000
# Also read by `npm run github:activation-check` to validate every
# policy-required CI Check Run source pin against branch protection.
MERGEPROOF_POLICY_PATH=/run/mergeproof/mergeproof.policy.json
MERGEPROOF_HARNESS_SPEC_PATH=/run/mergeproof/mergeproof.harness.json
MERGEPROOF_TRUSTED_HARNESS_PATH=/app/harness/mergeproof-harness.mjs
MERGEPROOF_TRUSTED_PROBES_DIR=/run/mergeproof/probes
MERGEPROOF_HARNESS_COMMAND=node /workspace/mergeproof-harness.mjs
# E2B lifetime is derived from the sealed harness spec at startup; there is no
# override. Aggregate probe schedules above 20 minutes fail closed.
# Use <template>:<immutable-build-id>; mutable names and tags are rejected.
MERGEPROOF_E2B_TEMPLATE=SET_IN_SECRET_MANAGER_OR_DEPLOYMENT_CONFIG
MERGEPROOF_DB_PATH=/app/data/mergeproof.sqlite
MERGEPROOF_WORKER_CONCURRENCY=2
# Bounded GitHub readback/recovery slots. Each slot receives its own fenced
# ledger worker id; this remains a single SQLite-backed process.
MERGEPROOF_RECONCILIATION_CONCURRENCY=2
MERGEPROOF_MAX_PENDING_WEBHOOK_EVENTS=10000
MERGEPROOF_MAX_PENDING_WEBHOOK_BYTES=268435456

GITHUB_APP_ID=SET_IN_SECRET_MANAGER
GITHUB_APP_PRIVATE_KEY=SET_IN_SECRET_MANAGER
GITHUB_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER
# Required only by `npm run github:activation-check`; this command is read-only.
MERGEPROOF_ACTIVATION_INSTALLATION_ID=SET_FOR_READ_ONLY_ACTIVATION_CHECK
MERGEPROOF_ACTIVATION_REPOSITORY=owner/repository
MERGEPROOF_ACTIVATION_BRANCH=main
OPENAI_API_KEY=SET_IN_SECRET_MANAGER
E2B_API_KEY=SET_IN_SECRET_MANAGER

# Leave disabled until trusted probes, GitHub App installation, merge-queue
# branch protection, and check-source policy pins are verified.
MERGEPROOF_OPERATOR_CONSOLE=false
# MERGEPROOF_OPERATOR_TOKEN=SET_IN_SECRET_MANAGER
