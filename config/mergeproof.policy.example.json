{
  "allowedRepositories": ["your-org/mergeproof-fixture"],
  "autoMergeEnabled": false,
  "mergeStrategy": "merge_queue",
  "verification": {
    "version": "2026-07-14",
    "requiredCheckIds": [
      "ci",
      "issue-reproduction",
      "checkout-invariants",
      "duplicate-race",
      "changed-hunks"
    ],
    "requiredMetricNames": ["p95_latency_ms", "peak_memory_mb"],
    "requireBugReproduction": true,
    "requireAdversarialChecks": true,
    "requireHunkClosure": true,
    "issueToProof": {
      "requireLinkedIssue": true,
      "requiredObligationIds": [
        "issue-reproduction",
        "checkout-invariants",
        "duplicate-race",
        "changed-hunks"
      ]
    },
    "metricThresholds": {
      "p95_latency_ms": { "maxRatio": 1.15, "maxAbsolute": 120 },
      "peak_memory_mb": { "maxRatio": 1.2, "maxAbsolute": 256 }
    }
  },
  "merge": {
    "requiredApprovals": 1,
    "requiredLabels": ["mergeproof:auto"],
    "requiredChecks": ["ci / test", "ci / security"],
    "requiredCheckAppIds": {
      "ci / test": 123456,
      "ci / security": 123456
    },
    "mergeMethod": "squash"
  }
}
